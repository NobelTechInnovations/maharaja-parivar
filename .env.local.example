# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/maharaja-parivaar

# Long random string used to sign session JWTs
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated emails that are always treated as admin on first login
ADMIN_EMAILS=info@maharajaparivar.in

# The site's real URL — used to build links in emails (password reset,
# account approved). Falls back to a placeholder if unset.
NEXT_PUBLIC_APP_URL=https://maharajaparivar.in

# --- Email (welcome, password reset, account approved) — see lib/email.js ---
# Any SMTP provider works: a Gmail account with an "app password", or a
# transactional provider's SMTP relay (Resend, Mailgun, SES, etc). Leave
# unset to run without real email — sends are logged to the console
# instead, so registration/reset/approval still work end-to-end in dev.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="Maharaja Parivaar <no-reply@maharajaparivar.in>"

# --- Not wired yet: reserved for the future OTP rollout (see lib/otp.js) ---
# OTP_ENABLED=false
# OTP_PROVIDER=msg91
# MSG91_AUTH_KEY=
